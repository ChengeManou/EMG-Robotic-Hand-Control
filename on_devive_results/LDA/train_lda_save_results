"""
train_lda_own.py

Train and evaluate LDA on the user's own EMG dataset.

Pipeline:

    CSV cycles
        ↓
    remove rest
        ↓
    150ms windows / 75% step
        ↓
    16 TD features
        ↓
    LDA
        ↓
    classification results
        ↓
    lda_results_data_old/  (confusion matrix PNG + CSVs)
"""

import time
from pathlib import Path

import numpy as np
import pandas as pd

import matplotlib
matplotlib.use("Agg")  # save to file, no display needed
import matplotlib.pyplot as plt

from sklearn.discriminant_analysis import LinearDiscriminantAnalysis
from sklearn.metrics import (
    accuracy_score,
    classification_report,
    confusion_matrix,
    ConfusionMatrixDisplay,
    precision_recall_fscore_support
)

from my_data_loader import (
    build_windowed_dataset,
    train_test_split_by_cycle
)


# ============================================================
# CONFIGURATION
# ============================================================

TRAIN_CYCLES = ( 2, 3, 4, 5, 6, 10)
TEST_CYCLES = (7,)

OUTPUT_DIR = Path(__file__).resolve().parent / "lda_results_data_old"


# ============================================================
# TIME-DOMAIN FEATURES
# ============================================================

def mav(x):
    return np.mean(np.abs(x))


def waveform_length(x):
    return np.sum(np.abs(np.diff(x)))


def zero_crossings(x, threshold=10):

    x1 = x[:-1]
    x2 = x[1:]

    crossings = (
        ((x1 >= 0) & (x2 < 0)) |
        ((x1 < 0) & (x2 >= 0))
    )

    amplitude_difference = np.abs(x1 - x2)

    crossings &= (
        amplitude_difference >= threshold
    )

    return np.sum(crossings)


def slope_sign_changes(x, threshold=10):

    d1 = x[1:-1] - x[:-2]
    d2 = x[2:] - x[1:-1]

    changes = (
        ((d1 > 0) & (d2 < 0)) |
        ((d1 < 0) & (d2 > 0))
    )

    amplitude_difference = np.abs(
        x[2:] - x[:-2]
    )

    changes &= (
        amplitude_difference >= threshold
    )

    return np.sum(changes)


def extract_td_features(window):

    features = []

    for ch in range(window.shape[1]):

        x = window[:, ch].astype(np.float64)

        # Mean removal
        x = x - np.mean(x)

        # MAV
        features.append(
            mav(x)
        )

        # ZC
        features.append(
            zero_crossings(x)
        )

        # SSC
        features.append(
            slope_sign_changes(x)
        )

        # WL
        features.append(
            waveform_length(x)
        )

    return np.asarray(
        features,
        dtype=np.float64
    )


# ============================================================
# FEATURE EXTRACTION
# ============================================================

def extract_features(X):

    features = []

    start = time.perf_counter()

    for window in X:

        features.append(
            extract_td_features(window)
        )

    elapsed = (
        time.perf_counter() - start
    )

    features = np.asarray(
        features,
        dtype=np.float64
    )

    return features, elapsed


# ============================================================
# SAVE RESULTS
# ============================================================

def save_results(
    out_dir,
    y_test,
    y_pred,
    cm,
    report_labels,
    label_map,
    summary
):
    """
    Writes everything into out_dir:
        confusion_matrix.png      counts + row-normalised (recall) views
        predictions.csv           one row per test window
        summary_metrics.csv       overall metrics, per-class metrics, confusion matrix
    """

    out_dir = Path(out_dir)
    out_dir.mkdir(parents=True, exist_ok=True)

    target_names = [label_map[i] for i in report_labels]

    # ---------------- confusion matrix image ----------------

    cm_norm = cm.astype(np.float64)
    row_sums = cm_norm.sum(axis=1, keepdims=True)
    cm_norm = np.divide(
        cm_norm,
        row_sums,
        out=np.zeros_like(cm_norm),
        where=row_sums != 0
    )

    size = max(6, 0.9 * len(target_names))
    fig, axes = plt.subplots(
        1, 2, figsize=(2 * size + 2, size + 1)
    )

    ConfusionMatrixDisplay(
        cm, display_labels=target_names
    ).plot(
        ax=axes[0],
        cmap="Blues",
        xticks_rotation=45,
        colorbar=False
    )
    axes[0].set_title("Confusion matrix (counts)")

    ConfusionMatrixDisplay(
        cm_norm, display_labels=target_names
    ).plot(
        ax=axes[1],
        cmap="Blues",
        xticks_rotation=45,
        values_format=".2f",
        colorbar=False
    )
    axes[1].set_title("Confusion matrix (row-normalised)")

    fig.suptitle(
        f"LDA — accuracy {summary['accuracy'] * 100:.2f}%"
    )
    fig.tight_layout()
    fig.savefig(
        out_dir / "confusion_matrix.png",
        dpi=200,
        bbox_inches="tight"
    )
    plt.close(fig)

    # ---------------- per-window predictions ----------------

    pd.DataFrame({
        "window_index": np.arange(len(y_test)),
        "true_label": y_test,
        "true_name": [label_map[i] for i in y_test],
        "pred_label": y_pred,
        "pred_name": [label_map[i] for i in y_pred],
        "correct": (y_test == y_pred)
    }).to_csv(
        out_dir / "predictions.csv",
        index=False
    )

    # ---------------- summary metrics ----------------

    precision, recall, f1, support = precision_recall_fscore_support(
        y_test,
        y_pred,
        labels=report_labels,
        zero_division=0
    )

    rows = []

    for key, value in summary.items():
        rows.append({
            "section": "overall",
            "name": key,
            "metric": "value",
            "value": value
        })

    for k, i in enumerate(report_labels):
        for metric, arr in (
            ("precision", precision),
            ("recall", recall),
            ("f1", f1),
            ("support", support)
        ):
            rows.append({
                "section": "per_class",
                "name": label_map[i],
                "metric": metric,
                "value": float(arr[k])
            })

    for r, i in enumerate(report_labels):
        for c, j in enumerate(report_labels):
            rows.append({
                "section": "confusion_matrix",
                "name": f"true={label_map[i]}",
                "metric": f"pred={label_map[j]}",
                "value": int(cm[r, c])
            })

    pd.DataFrame(rows).to_csv(
        out_dir / "summary_metrics.csv",
        index=False
    )

    print()
    print(f"Results saved to: {out_dir}")
    for f in sorted(out_dir.iterdir()):
        print(f"  {f.name}")


# ============================================================
# MAIN
# ============================================================

def main():

    print()
    print("=" * 70)
    print("OWN EMG DATASET — LDA")
    print("=" * 70)

    print()
    print("Training cycles:", TRAIN_CYCLES)
    print("Testing cycles :", TEST_CYCLES)

    # ========================================================
    # LOAD DATA
    # ========================================================

    windows = build_windowed_dataset()

    (
        X_train,
        y_train,
        X_test,
        y_test,
        label_map
    ) = train_test_split_by_cycle(
        windows,
        train_cycles=TRAIN_CYCLES,
        test_cycles=TEST_CYCLES
    )

    # ========================================================
    # LABEL MAP
    # ========================================================

    print()
    print("=" * 70)
    print("LABEL MAP")
    print("=" * 70)

    print(label_map)

    # ========================================================
    # CHECK LABEL COUNTS
    # ========================================================

    print()
    print("Training label counts:")

    for label in sorted(label_map):

        print(
            f"  {label}: "
            f"{label_map[label]:20s} "
            f"{np.sum(y_train == label)} samples"
        )

    print()
    print("Testing label counts:")

    for label in sorted(label_map):

        print(
            f"  {label}: "
            f"{label_map[label]:20s} "
            f"{np.sum(y_test == label)} samples"
        )

    # ========================================================
    # WINDOW DATA
    # ========================================================

    print()
    print("=" * 70)
    print("WINDOW DATA")
    print("=" * 70)

    print(
        "X_train:",
        X_train.shape
    )

    print(
        "X_test :",
        X_test.shape
    )

    # ========================================================
    # EXTRACT FEATURES
    # ========================================================

    print()
    print("=" * 70)
    print("EXTRACTING 16 TD FEATURES")
    print("=" * 70)

    X_train_feat, train_feat_time = (
        extract_features(X_train)
    )

    X_test_feat, test_feat_time = (
        extract_features(X_test)
    )

    print(
        "Training features:",
        X_train_feat.shape
    )

    print(
        "Testing features :",
        X_test_feat.shape
    )

    print(
        f"Training feature extraction: "
        f"{train_feat_time:.3f} s"
    )

    print(
        f"Testing feature extraction: "
        f"{test_feat_time:.3f} s"
    )

    # ========================================================
    # TRAIN LDA
    # ========================================================

    print()
    print("=" * 70)
    print("TRAINING LDA")
    print("=" * 70)

    lda = LinearDiscriminantAnalysis()

    train_start = time.perf_counter()

    lda.fit(
        X_train_feat,
        y_train
    )

    train_time = (
        time.perf_counter()
        - train_start
    )

    print(
        f"LDA training time: "
        f"{train_time:.6f} s"
    )

    # ========================================================
    # TEST
    # ========================================================

    print()
    print("=" * 70)
    print("TESTING LDA")
    print("=" * 70)

    inference_start = time.perf_counter()

    y_pred = lda.predict(
        X_test_feat
    )

    inference_time = (
        time.perf_counter()
        - inference_start
    )

    # ========================================================
    # ACCURACY
    # ========================================================

    accuracy = accuracy_score(
        y_test,
        y_pred
    )

    print()
    print(
        f"Accuracy: {accuracy:.4f}"
    )

    print(
        f"Accuracy: {accuracy * 100:.2f}%"
    )

    # ========================================================
    # TIMING
    # ========================================================

    n_test = len(y_test)

    print()
    print("Timing")
    print("-" * 40)

    print(
        f"Total LDA inference: "
        f"{inference_time:.6f} s"
    )

    print(
        f"Average LDA inference: "
        f"{inference_time / n_test * 1e6:.2f} us/window"
    )

    print(
        f"Average feature extraction: "
        f"{test_feat_time / n_test * 1e6:.2f} us/window"
    )

    print(
        f"Average total: "
        f"{(inference_time + test_feat_time) / n_test * 1e6:.2f} us/window"
    )

    # ========================================================
    # CLASSIFICATION REPORT
    # ========================================================

    print()
    print("=" * 70)
    print("CLASSIFICATION REPORT")
    print("=" * 70)

    report_labels = sorted(
        label_map.keys()
    )

    target_names = [
        label_map[i]
        for i in report_labels
    ]

    print(
        classification_report(
            y_test,
            y_pred,
            labels=report_labels,
            target_names=target_names,
            zero_division=0
        )
    )

    # ========================================================
    # CONFUSION MATRIX
    # ========================================================

    print()
    print("=" * 70)
    print("CONFUSION MATRIX")
    print("=" * 70)

    cm = confusion_matrix(
        y_test,
        y_pred,
        labels=report_labels
    )

    print(cm)

    # ========================================================
    # PER-CLASS ACCURACY
    # ========================================================

    print()
    print("=" * 70)
    print("PER-CLASS RESULTS")
    print("=" * 70)

    for i in report_labels:

        mask = (
            y_test == i
        )

        if np.sum(mask) == 0:
            continue

        class_accuracy = np.mean(
            y_pred[mask] == i
        )

        print(
            f"{label_map[i]:25s} "
            f"{class_accuracy * 100:6.2f}% "
            f"({np.sum(mask)} samples)"
        )

    # ========================================================
    # FINAL SUMMARY
    # ========================================================

    print()
    print("=" * 70)
    print("FINAL SUMMARY")
    print("=" * 70)

    print(
        f"Number of TD features : "
        f"{X_train_feat.shape[1]}"
    )

    print(
        f"Training samples      : "
        f"{len(y_train)}"
    )

    print(
        f"Testing samples       : "
        f"{len(y_test)}"
    )

    print(
        f"LDA accuracy          : "
        f"{accuracy * 100:.2f}%"
    )

    print(
        f"Average inference     : "
        f"{inference_time / n_test * 1e6:.2f} us"
    )

    print(
        f"Average feature time  : "
        f"{test_feat_time / n_test * 1e6:.2f} us"
    )

    print("=" * 70)

    # ========================================================
    # SAVE RESULTS (PNG + CSVs -> lda_results_data_old/)
    # ========================================================

    summary = {
        "train_cycles": str(TRAIN_CYCLES),
        "test_cycles": str(TEST_CYCLES),
        "n_features": X_train_feat.shape[1],
        "n_train_windows": len(y_train),
        "n_test_windows": n_test,
        "accuracy": accuracy,
        "train_feature_time_s": train_feat_time,
        "test_feature_time_s": test_feat_time,
        "lda_train_time_s": train_time,
        "lda_inference_time_s": inference_time,
        "avg_inference_us_per_window": inference_time / n_test * 1e6,
        "avg_feature_us_per_window": test_feat_time / n_test * 1e6,
        "avg_total_us_per_window": (
            (inference_time + test_feat_time) / n_test * 1e6
        )
    }

    save_results(
        OUTPUT_DIR,
        y_test,
        y_pred,
        cm,
        report_labels,
        label_map,
        summary
    )


if __name__ == "__main__":
    main()